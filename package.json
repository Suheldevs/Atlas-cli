{
  "name": "@mohdsuhel/atlas",
  "version": "0.1.0",
  "description": "Generate production-grade TypeScript modules straight into your project. Your code stays yours — no runtime dependency, ever.",
  "keywords": [
    "cli",
    "codegen",
    "code-generator",
    "scaffold",
    "scaffolding",
    "generator",
    "schematics",
    "boilerplate",
    "express",
    "typescript",
    "jwt",
    "authentication",
    "developer-tools"
  ],
  "license": "MIT",
  "author": "Suhel <abhay@quippy.co>",
  "homepage": "https://github.com/Suheldevs/Atlas-cli#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Suheldevs/Atlas-cli.git"
  },
  "bugs": {
    "url": "https://github.com/Suheldevs/Atlas-cli/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "atlas": "bin/atlas.js",
    "atlas-cli": "bin/atlas.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "dist",
    "templates",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup && npm run build:types",
    "build:types": "tsc -p tsconfig.build.json --emitDeclarationOnly",
    "build:watch": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "validate:templates": "tsx scripts/validate-templates.ts && tsx scripts/check-generated-output.ts",
    "verify": "npm run typecheck && npm run lint && npm run format:check && npm run test && npm run build",
    "prepublishOnly": "npm run verify"
  },
  "dependencies": {
    "@inquirer/prompts": "^8.6.0",
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "execa": "^10.0.1",
    "fs-extra": "^11.4.0",
    "ora": "^9.4.1",
    "prettier": "^3.9.6"
  },
  "devDependencies": {
    "@changesets/cli": "^2.31.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^5.0.6",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.2.0",
    "@types/node": "^26.1.1",
    "bcryptjs": "^3.0.3",
    "cookie-parser": "^1.4.7",
    "eslint": "^10.8.0",
    "express": "^5.2.1",
    "ioredis": "^5.11.1",
    "jose": "^6.2.4",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "socket.io": "^4.8.3",
    "tsup": "^8.5.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
