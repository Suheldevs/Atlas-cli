# Where the API lives, including the /api prefix.
#
# Leave this unset in development: the client then calls the relative path /api, which the Vite dev
# server proxies to the API (see vite.config.js). Same origin means the httpOnly refresh cookie is
# sent with every request, which is what the refresh flow depends on.
#
# Set it only when the client is served from a different origin than the API in production. The API
# must then send Access-Control-Allow-Credentials and name this client's origin explicitly.
VITE_API_URL=http://localhost:5000/api
