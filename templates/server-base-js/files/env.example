# ---------------------------------------------------------------------------
# Every variable src/config/env.ts knows about. Copy this file to .env.
# The server validates all of them at boot and refuses to start on any problem,
# reporting every one at once rather than the first.
# ---------------------------------------------------------------------------

# Runtime environment. One of: development | test | production
# Optional — defaults to development. Production hides error stacks from responses.
NODE_ENV=development

# Port the HTTP server binds. A whole number between 1 and 65535.
# Optional — defaults to 5000.
PORT=5000

# MongoDB connection string. REQUIRED.
# Must start with mongodb:// or mongodb+srv://.
MONGODB_URI=mongodb://127.0.0.1:27017/app_development

# Let Mongoose build the indexes declared by your schemas when it connects.
# Exactly "true" or "false". Optional — defaults to false, because in production an index
# build is a migration with its own review, not something a deploy should trigger.
DB_AUTO_INDEX=true

# Absolute origin of the browser client. It is the single origin the CORS allowlist permits.
# Optional — defaults to http://localhost:5173. Credentials are enabled, so "*" is not an option.
CLIENT_URL=http://localhost:5173

# Secret signing the short-lived access token. REQUIRED, at least 32 characters.
# The placeholder below is REJECTED at boot. Generate a real one:
#   openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-characters-long

# Secret signing the long-lived refresh token. REQUIRED, at least 32 characters, and
# different from JWT_ACCESS_SECRET. The placeholder below is REJECTED at boot.
JWT_REFRESH_SECRET=change-me-refresh-secret-at-least-32-characters-long

# How long an access token stays valid. A duration such as 15m, 24h or 7d.
# Optional — defaults to 15m.
JWT_ACCESS_TTL=15m

# How long a refresh token stays valid. A duration such as 15m, 24h or 7d.
# Optional — defaults to 7d.
JWT_REFRESH_TTL=7d
